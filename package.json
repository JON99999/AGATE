{
  "name": "interstitial-er",
  "private": true,
  "version": "0.9.1",
  "description": "Cross-platform Desktop MP3 Scheduler optimized for MacOS and Windows.",
  "author": "JON99999",
  "repository": {
    "type": "git",
    "url": "https://github.com/JON99999/Interstitial-er.git"
  },
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'server.js'].forEach(p => { if (fs.existsSync(p)) fs.rmSync(p, { recursive: true, force: true }) })\"",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "desktop": "npm run build && electron .",
    "dist": "node build-apps.cjs"
  },
  "build": {
    "appId": "com.interstitialer.scheduler",
    "productName": "Interstitial-er",
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "differentialPackage": false,
      "writeUpdateMetadata": false,
      "artifactName": "${productName}-${version}-Windows-Installer.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Windows-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "icon": "build/icon.icns",
      "writeUpdateMetadata": false,
      "differentialPackage": false
    },
    "dmg": {
      "differentialPackage": false,
      "writeUpdateMetadata": false
    }
  },
  "dependencies": {
    "express": "^4.21.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "dotenv": "^17.2.3",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "firebase": "^12.13.0",
    "jimp": "^1.6.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
